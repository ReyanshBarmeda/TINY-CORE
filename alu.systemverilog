// ============================================================================
// MODULE: Arithmetic Logic Unit (ALU)
// DESCRIPTION: The 64-bit math and logic engine for the RISC-V core.
// ============================================================================

module alu (
    input  logic [63:0] rs1_data,   // Source register 1 data
    input  logic [63:0] rs2_data,   // Source register 2 data
    input  logic [3:0]  alu_op,     // 4-bit control signal to choose the operation
    output logic [63:0] alu_result, // The 64-bit answer
    output logic        zero        // Flag: is the result zero? (Used for branches)
);

    // Define ALU operation codes (Opcodes)
    localparam ALU_ADD  = 4'b0000;
    localparam ALU_SUB  = 4'b1000;
    localparam ALU_AND  = 4'b0111;
    localparam ALU_OR   = 4'b0110;
    localparam ALU_XOR  = 4'b0100;
    localparam ALU_SLL  = 4'b0001; // Shift Left Logical
    localparam ALU_SRL  = 4'b0101; // Shift Right Logical
    localparam ALU_SRA  = 4'b1101; // Shift Right Arithmetic

    // Perform the requested operation
    always_comb begin
        case (alu_op)
            ALU_ADD: alu_result = rs1_data + rs2_data;
            ALU_SUB: alu_result = rs1_data - rs2_data;
            ALU_AND: alu_result = rs1_data & rs2_data;
            ALU_OR:  alu_result = rs1_data | rs2_data;
            ALU_XOR: alu_result = rs1_data ^ rs2_data;
            
            // Shift operations (using the lowest 6 bits of rs2 for a 64-bit shift amount)
            ALU_SLL: alu_result = rs1_data << rs2_data[5:0];
            ALU_SRL: alu_result = rs1_data >> rs2_data[5:0];
            ALU_SRA: alu_result = $signed(rs1_data) >>> rs2_data[5:0];
            
            default: alu_result = 64'b0; // Default case to prevent latches
        endcase
    end

    // The zero flag is highly important for RISC-V 'BEQ' (Branch if Equal) instructions
    assign zero = (alu_result == 64'b0);

endmodule