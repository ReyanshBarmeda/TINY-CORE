// ============================================================================
// MODULE: Immediate Generator
// DESCRIPTION: Extracts immediate values (constants) from 32-bit instructions
//              and sign-extends them to 64 bits for the ALU.
// ============================================================================

module imm_gen (
    input  logic [31:0] instruction, // Raw 32-bit instruction
    output logic [63:0] imm_ext      // 64-bit sign-extended immediate value
);

    // Extract opcode to determine instruction format
    logic [6:0] opcode;
    assign opcode = instruction[6:0];

    // Instruction Opcodes mapped to formats
    localparam OPCODE_I_TYPE  = 7'b0010011; // ADDI, etc.
    localparam OPCODE_LOAD    = 7'b0000011; // LD, LW
    localparam OPCODE_STORE   = 7'b0100011; // SD, SW (S-Type)
    localparam OPCODE_BRANCH  = 7'b1100011; // BEQ, BNE (B-Type)
    localparam OPCODE_LUI     = 7'b0110111; // LUI (U-Type)
    localparam OPCODE_AUIPC   = 7'b0010111; // AUIPC (U-Type)
    localparam OPCODE_JAL     = 7'b1101111; // JAL (J-Type)
    localparam OPCODE_JALR    = 7'b1100111; // JALR (I-Type)

    always_comb begin
        // Default to zero to prevent latches
        imm_ext = 64'b0;

        case (opcode)
            // ------------------------------------------------------------
            // I-Type (Loads, ADDI, JALR)
            // The immediate is stored in the top 12 bits [31:20].
            // We replicate the sign bit (bit 31) 52 times to make it 64-bit.
            // ------------------------------------------------------------
            OPCODE_I_TYPE, OPCODE_LOAD, OPCODE_JALR: begin
                imm_ext = { {52{instruction[31]}}, instruction[31:20] };
            end

            // ------------------------------------------------------------
            // S-Type (Stores)
            // The immediate is split between [31:25] and [11:7].
            // ------------------------------------------------------------
            OPCODE_STORE: begin
                imm_ext = { {52{instruction[31]}}, instruction[31:25], instruction[11:7] };
            end

            // ------------------------------------------------------------
            // B-Type (Branches)
            // Split into [31], [7], [30:25], and [11:8].
            // Note: Branches are always multiples of 2, so bit 0 is a 0.
            // ------------------------------------------------------------
            OPCODE_BRANCH: begin
                imm_ext = { {51{instruction[31]}}, instruction[31], instruction[7], instruction[30:25], instruction[11:8], 1'b0 };
            end

            // ------------------------------------------------------------
            // U-Type (LUI, AUIPC)
            // Upper immediate. Placed in bits [31:12]. 
            // ------------------------------------------------------------
            OPCODE_LUI, OPCODE_AUIPC: begin
                // Note: U-Type immediate shifts the value to the upper 20 bits of a 32-bit word, 
                // then sign extends to 64 bits.
                imm_ext = { {32{instruction[31]}}, instruction[31:12], 12'b0 };
            end

            // ------------------------------------------------------------
            // J-Type (JAL - Jump)
            // Heavily shuffled to save space.
            // ------------------------------------------------------------
            OPCODE_JAL: begin
                imm_ext = { {43{instruction[31]}}, instruction[31], instruction[19:12], instruction[20], instruction[30:21], 1'b0 };
            end

            default: imm_ext = 64'b0;
        endcase
    end

endmodule